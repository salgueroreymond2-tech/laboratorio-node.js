{
  "name": "securevault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint src tests migrations scripts/migrate.js scripts/adopt-existing.js scripts/check-release.js scripts/export-research.js scripts/seed-demo.js",
    "format:check": "prettier --check src tests migrations scripts/migrate.js scripts/adopt-existing.js scripts/check-release.js scripts/export-research.js scripts/seed-demo.js eslint.config.js",
    "db:migrate": "node scripts/migrate.js",
    "db:check-existing": "node scripts/adopt-existing.js",
    "demo:seed": "node scripts/seed-demo.js",
    "test": "node --test tests/unit/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:security": "node --test tests/security/*.test.js",
    "check:release": "node scripts/check-release.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.1.0",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "prettier": "^3.10.1"
  }
}
