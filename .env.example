# Copia este archivo como .env y completa tus datos locales.
NODE_ENV=development
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=securevault_db
DB_USER=
DB_PASSWORD=

# Requeridos para producción: origen HTTPS y certificado CA para MySQL TLS.
APP_URL=
DB_TLS_CA=

# Secretos independientes generados con un generador criptográfico (mínimo 43 caracteres).
SESSION_SECRET=
CSRF_SECRET=

# 32 bytes aleatorios codificados como 64 caracteres hexadecimales.
# Consérvala de forma segura: sin ella no se pueden descifrar las notas.
NOTES_ENCRYPTION_KEY=

# Clave independiente para firmar eventos de seguridad (32 bytes en hexadecimal).
AUDIT_HMAC_KEY=

# Opcional: para recuperación de contraseña; configurar todos o ninguno.
# El servidor exige TLS para SMTP. No uses credenciales reales en este archivo.
MAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Alternativa a SMTP_PASSWORD; no usar las dos con valores distintos.
SMTP_PASS=
SMTP_FROM=
PUBLIC_BASE_URL=

# Alternativa a SMTP para Railway Free, Trial y Hobby: API HTTPS de Resend.
# Usa MAIL_PROVIDER=resend, una clave limitada a envíos y un remitente autorizado.
RESEND_API_KEY=
RESEND_FROM=

# Cuenta separada con permisos de migración; no usar durante la ejecución normal.
MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=3306
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=
# Solo para una migración de producción autorizada y supervisada.
MIGRATION_DB_TLS_CA=
CONFIRM_PRODUCTION_MIGRATION=

# Cuenta destinada exclusivamente a securevault_test_db.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=
TEST_DB_PASSWORD=

# Solo para inicializar un volumen Docker MySQL nuevo; usar cuatro valores
# distintos de al menos 24 caracteres ASCII alfanuméricos, guion o guion bajo.
DB_ROOT_PASSWORD=
DB_APP_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_TEST_PASSWORD=
