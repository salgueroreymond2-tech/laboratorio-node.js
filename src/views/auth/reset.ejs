<%- include('../partials/head', { title: 'Restablecer contraseña' }) %>
<main class="account-layout" id="contenido"><div class="account-card"><a class="account-brand" href="/inicio"><img src="/assets/images/brand/isotipo.svg" width="38" height="38" alt=""> SecureVault</a><p class="auth-eyebrow">SEGURIDAD</p><h1>Restablecer contraseña</h1><p>Escribe y confirma tu nueva contraseña.</p><% if (message) { %><div class="auth-message" role="alert"><%= message %></div><% } %><% if (token) { %><form method="post" action="/restablecer" class="auth-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="token" value="<%= token %>"><label for="password">Contraseña nueva</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="12" required><label for="confirmPassword">Confirmar contraseña</label><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" required><button type="submit">Restablecer contraseña</button></form><% } %><div class="notes-actions"><a class="notes-text-link" href="/acceso">Volver a iniciar sesión</a></div></div></main>
</body></html>
