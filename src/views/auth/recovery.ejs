<%- include('../partials/head', { title: 'Recuperar contraseña' }) %>
<main class="account-layout" id="contenido"><div class="account-card"><a class="account-brand" href="/inicio"><img src="/assets/images/brand/isotipo.svg" width="38" height="38" alt=""> SecureVault</a><p class="auth-eyebrow">SEGURIDAD</p><h1>Recuperar contraseña</h1><% if (available) { %><p>Introduce tu correo para recibir instrucciones.</p><% } else { %><p>La recuperación por correo todavía no está configurada. Si puedes iniciar sesión, cambia tu contraseña desde el perfil.</p><% } %><% if (message) { %><div class="auth-message" role="status"><%= message %></div><% } %><% if (available) { %><form method="post" action="/recuperar" class="auth-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="email">Correo electrónico</label><input id="email" type="email" name="email" maxlength="254" autocomplete="email" required><button type="submit">Enviar instrucciones</button></form><% } %><div class="notes-actions"><a class="notes-text-link" href="/acceso">Volver a iniciar sesión</a></div></div></main>
</body></html>
