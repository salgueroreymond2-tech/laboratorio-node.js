<%- include('../partials/head', { title: 'Crear cuenta' }) %>
<main class="auth-layout" id="contenido">
  <section class="auth-intro"><a class="auth-brand" href="/inicio"><img src="/assets/images/brand/isotipo-light.svg" width="40" height="40" alt=""> SecureVault</a><div><p class="auth-eyebrow">EMPIEZA AQUÍ</p><h1>Tu espacio comienza contigo.</h1><p>Crea una cuenta para empezar a guardar notas privadas.</p></div><small>SecureVault · Entorno local</small></section>
  <section class="auth-panel"><div class="auth-card"><a class="auth-back" href="/inicio">Volver al inicio</a><h2>Crear cuenta</h2><p>Completa tus datos para comenzar.</p>
    <% if (message) { %><div class="auth-message" role="status"><%= message %></div><% } %>
    <form method="post" action="/registro" class="auth-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="name">Nombre</label><input id="name" name="name" autocomplete="name" minlength="2" maxlength="120" required><label for="email">Correo electrónico</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254"><label for="password">Contraseña</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="12" aria-describedby="password-help" required><small id="password-help">Al menos 12 caracteres y máximo 72 bytes UTF-8. Evita contraseñas comunes.</small><button type="submit">Crear mi cuenta</button></form>
    <p class="auth-switch">¿Ya tienes cuenta? <a href="/acceso">Iniciar sesión</a></p>
  </div></section>
</main></body></html>
