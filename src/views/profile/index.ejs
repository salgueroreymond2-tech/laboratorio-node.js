<%- include('../partials/head', { title: 'Mi perfil' }) %>
<main class="notes-layout notes-narrow" id="contenido">
  <header class="notes-top"><a class="notes-brand" href="/cuenta"><img src="/assets/images/brand/isotipo.svg" width="34" height="34" alt=""> SecureVault</a><a class="notes-text-link" href="/cuenta">Mi cuenta</a></header>
  <div class="notes-heading"><div><p class="notes-kicker">TU CUENTA</p><h1>Mi perfil</h1><p>Gestiona tus datos personales y seguridad.</p></div></div>
  <section class="notes-paper"><h2>Datos personales</h2><p class="notes-help">Correo: <%= profile.email %></p><p class="notes-help">Teléfono: <%= profile.phone || 'No registrado' %> <% if (profile.hasPhone && !reveal) { %><a class="notes-text-link" href="/perfil/telefono">Mostrar teléfono</a><% } else if (reveal) { %><a class="notes-text-link" href="/perfil">Ocultar teléfono</a><% } %></p>
    <% if (message) { %><div class="auth-message" role="alert"><%= message %></div><% } %>
    <form method="post" action="/perfil" class="notes-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="name">Nombre</label><input id="name" name="name" value="<%= profile.name %>" minlength="2" maxlength="120" autocomplete="name" required><label for="phone">Teléfono nuevo (opcional)</label><input id="phone" name="phone" type="tel" maxlength="25" autocomplete="tel" aria-describedby="phone-help"><p class="notes-help" id="phone-help">Déjalo vacío para conservar el número actual. Se guarda cifrado.</p><% if (profile.hasPhone) { %><label><input type="checkbox" name="clearPhone" value="yes"> Eliminar mi teléfono guardado</label><% } %><div class="notes-actions"><button class="notes-button" type="submit">Guardar cambios</button><a class="notes-secondary" href="/cuenta">Cancelar</a></div></form>
  </section><section class="notes-paper profile-security"><h2>Seguridad</h2><p>Al cambiar tu contraseña se cerrarán tus otras sesiones.</p><a class="notes-text-link" href="/perfil/contrasena">Cambiar contraseña</a></section>
</main></body></html>
