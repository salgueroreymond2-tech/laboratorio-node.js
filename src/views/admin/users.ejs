<%- include('../partials/head', { title: 'Usuarios' }) %>
<main class="notes-layout" id="contenido"><header class="notes-top"><a class="notes-brand" href="/admin"><img src="/assets/images/brand/isotipo.svg" width="34" height="34" alt=""> Administración</a><a class="notes-text-link" href="/admin">Panel</a></header><div class="notes-heading"><div><p class="notes-kicker">ADMINISTRACIÓN</p><h1>Usuarios</h1><p>Información básica de las cuentas registradas.</p></div></div>
<section class="notes-paper admin-table-wrap"><table class="admin-table"><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Acción</th></tr></thead><tbody><% for (const user of users) { %><tr><td><%= user.name %></td><td><%= user.email %></td><td><%= user.role === 'admin' ? 'Administrador' : 'Usuario' %></td><td><%= user.status === 'active' ? 'Activo' : 'Suspendido' %></td><td><a class="notes-text-link" href="/admin/usuarios/<%= user.id %>/rol">Gestionar rol</a></td></tr><% } %></tbody></table><% if (users.length === 0) { %><p class="notes-help">No hay usuarios en esta página.</p><% } %></section>
<% if (page > 1 || hasNext) { %><nav class="notes-actions" aria-label="Páginas de usuarios"><% if (page > 1) { %><a class="notes-text-link" href="/admin/usuarios?page=<%= page - 1 %>">Página anterior</a><% } %><span>Página <%= page %></span><% if (hasNext) { %><a class="notes-text-link" href="/admin/usuarios?page=<%= page + 1 %>">Página siguiente</a><% } %></nav><% } %>
</main></body></html>
