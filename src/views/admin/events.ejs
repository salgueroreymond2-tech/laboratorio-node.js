<%- include('../partials/head', { title: 'Eventos de seguridad' }) %>
<main class="notes-layout" id="contenido"><header class="notes-top"><a class="notes-brand" href="/admin"><img src="/assets/images/brand/isotipo.svg" width="34" height="34" alt=""> Administración</a><a class="notes-text-link" href="/admin">Panel</a></header><div class="notes-heading"><div><p class="notes-kicker">ADMINISTRACIÓN</p><h1>Eventos de seguridad</h1><p>Accesos registrados y comprobación de su firma.</p></div></div>
<section class="notes-paper admin-table-wrap"><table class="admin-table"><thead><tr><th>Fecha UTC</th><th>Evento</th><th>Nivel</th><th>Firma</th></tr></thead><tbody><% for (const event of events) { %><tr><td><%= event.createdAt %></td><td><%= event.type === 'auth_login_success' ? 'Inicio de sesión' : event.type === 'auth_login_failed' ? 'Intento fallido' : event.type %></td><td><%= event.severity %></td><td><%= event.valid ? 'Válida' : 'Alterada o no verificable' %></td></tr><% } %></tbody></table><% if (events.length === 0) { %><p class="notes-help">Todavía no hay eventos de acceso registrados.</p><% } %></section>
<p class="notes-help">La firma detecta cambios en los campos firmados; no detecta por sí sola la eliminación de registros.</p><% if (page > 1 || hasNext) { %><nav class="notes-actions" aria-label="Páginas de eventos"><% if (page > 1) { %><a class="notes-text-link" href="/admin/eventos?page=<%= page - 1 %>">Página anterior</a><% } %><span>Página <%= page %></span><% if (hasNext) { %><a class="notes-text-link" href="/admin/eventos?page=<%= page + 1 %>">Página siguiente</a><% } %></nav><% } %>
</main></body></html>
