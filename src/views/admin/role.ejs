<%- include('../partials/head', { title: 'Gestionar rol' }) %>
<main class="notes-layout notes-narrow" id="contenido"><header class="notes-top"><a class="notes-brand" href="/admin"><img src="/assets/images/brand/isotipo.svg" width="34" height="34" alt=""> Administración</a><a class="notes-text-link" href="/admin/usuarios">Usuarios</a></header><div class="notes-heading"><div><p class="notes-kicker">ADMINISTRACIÓN</p><h1>Gestionar rol</h1><p>Cuenta: <%= target.name %> · <%= target.email %></p></div></div>
<section class="notes-paper"><p>Rol actual: <strong><%= target.role === 'admin' ? 'Administrador' : 'Usuario' %></strong>.</p><p class="notes-help">El cambio se registra en la bitácora y cierra las sesiones de esta cuenta. No puedes cambiar tu propio rol.</p><% if (message) { %><div class="auth-message" role="alert"><%= message %></div><% } %><form method="post" action="/admin/usuarios/<%= target.id %>/rol" class="notes-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="role">Nuevo rol</label><select id="role" name="role"><option value="user" <%= target.role === 'user' ? 'selected' : '' %>>Usuario</option><option value="admin" <%= target.role === 'admin' ? 'selected' : '' %>>Administrador</option></select><label for="currentPassword">Tu contraseña de administrador</label><input id="currentPassword" type="password" name="currentPassword" autocomplete="current-password" required><div class="notes-actions"><button class="notes-button" type="submit">Guardar rol</button><a class="notes-secondary" href="/admin/usuarios">Cancelar</a></div></form></section>
</main></body></html>
